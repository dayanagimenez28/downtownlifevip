{
  // Configuración para Cloudflare: publica la carpeta dist/ en el Worker de la web
  "name": "plain-star-0ac4",
  "compatibility_date": "2026-10-01",
  // Pequeño script que redirige http:// a https:// antes de servir la web
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
